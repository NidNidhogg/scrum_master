# Telegram
TG_TOKEN=your_telegram_bot_token_here
LEAD_TG_ID=123456789          # Numeric Telegram ID of the Lead user
TEAM_CHAT_ID=-100123456789    # Numeric Telegram ID of the team group chat (negative for groups)

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Database  (use sqlite+aiosqlite:///./scrum_master.db for local dev)
DB_URL=sqlite+aiosqlite:///./scrum_master.db

# Scheduler timezone
TZ=Europe/Moscow
